<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniGetUI.Avalonia.App"
             xmlns:avaloniaApplication1="clr-namespace:UniGetUI.Avalonia"
             Name="UniGetUI"
             RequestedThemeVariant="Default">

    <!-- macOS: Avalonia injects a default app menu with an "About Avalonia" entry when the
         application declares none. Declaring an empty one suppresses it; the standard
         Services/Hide/Quit items are still appended by the native menu exporter. -->
    <NativeMenu.Menu>
        <NativeMenu />
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <avaloniaApplication1:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <StyleInclude Source="avares://UniGetUI/Assets/Styles/Styles.Common.axaml"/>
    </Application.Styles>
</Application>
